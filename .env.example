# Скопируйте этот файл в .env (без .example) и заполните.
# Файл .env не загружайте в GitHub: там секреты.

# 1 — режим разработки на своём компьютере, 0 — на настоящем сервере
DEBUG=1

# Длинная случайная строка. Сгенерировать:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Адреса, по которым открывается сайт, через запятую
ALLOWED_HOSTS=127.0.0.1,localhost
# На сервере с https, например: https://tanda.kg
CSRF_TRUSTED_ORIGINS=
# 1, если сайт работает по https за прокси (Render, Railway, nginx)
HTTPS=0

# Ключ Anthropic API для помощника, подсказки цены и осмотра по фото: console.anthropic.com
ANTHROPIC_API_KEY=
# Модель Claude. Дешевле и быстрее: claude-haiku-5-5. Умнее: claude-opus-5-5
ANTHROPIC_MODEL=claude-sonnet-5-5
